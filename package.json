{
  "name": "home-catalogue",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --project demo-home-catalogue-rules-test --only firestore \"vitest run --dir test/rules --no-file-parallelism\"",
    "ux": "node scripts/ux.ts",
    "theme": "node src/ui/writeTheme.ts",
    "icons": "node src/ui/writeIcons.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "data-platform": "github:nadav-alon/data-platform#v0.10.2",
    "firebase": "^12.19.0",
    "preact": "^10.29.8",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@iconify-json/material-symbols": "^1.2.93",
    "@material/material-color-utilities": "0.3.0",
    "@preact/preset-vite": "^2.10.6",
    "@resvg/resvg-js": "^2.6.2",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "^3.2.4",
    "@types/qrcode": "^1.5.6",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.32.0",
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  }
}
